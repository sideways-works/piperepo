# Editors format on save the way the checks expect (Biome for TS, JS, JSON
# and CSS; gofmt for Go; go run ./ci whitespace for the rest).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[{Makefile,*.mk}]
indent_style = tab

[*.md]
# Two trailing spaces are a Markdown line break; we don't use them.
trim_trailing_whitespace = true
