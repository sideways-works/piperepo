load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "sign",
    srcs = ["sign.go"],
    importpath = "github.com/sideways-works/piperepo/internal/sign",
    visibility = ["//:__subpackages__"],
    deps = [
        "@com_github_protonmail_go_crypto//openpgp",
        "@com_github_protonmail_go_crypto//openpgp/armor",
        "@com_github_protonmail_go_crypto//openpgp/clearsign",
        "@com_github_protonmail_go_crypto//openpgp/packet",
    ],
)

go_test(
    name = "sign_test",
    srcs = ["sign_test.go"],
    embed = [":sign"],
    deps = [
        "@com_github_protonmail_go_crypto//openpgp",
        "@com_github_protonmail_go_crypto//openpgp/clearsign",
    ],
)
